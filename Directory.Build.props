<Project>

  <!-- Configuración común a todos los proyectos de la solución RelojChecador.
       Cada .csproj individual solo debe declarar lo que lo hace distinto
       (TargetFramework especial, UseWPF, paquetes propios, etc.). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Company>Reloj Checador Carwash</Company>
    <Product>Reloj Checador</Product>

    <!-- Fuente única de la versión de la app — RelojChecador.WPF la lee en tiempo de
         ejecución (Assembly.GetEntryAssembly().GetName().Version) para mostrarla en la UI
         y compararla contra la última versión publicada en GitHub Releases (ver
         RelojChecador.Infrastructure.Updates). installer/RelojChecador.iss tiene su
         propio "MyAppVersion" (Inno Setup no puede leer un .props de MSBuild) — hay que
         mantenerlos sincronizados a mano en cada release; ver installer/README.md. -->
    <Version>1.10.11</Version>
  </PropertyGroup>

</Project>
