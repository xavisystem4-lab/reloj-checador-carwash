<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta oscura — mismas claves que Colors.Light.xaml, ver ese archivo para la
         explicación del mecanismo de intercambio (ThemeService). -->

    <SolidColorBrush x:Key="BrushWindowBackground" Color="#16181C" />
    <SolidColorBrush x:Key="BrushSurface" Color="#1E2126" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#262A31" />
    <SolidColorBrush x:Key="BrushBorder" Color="#33373E" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#454A52" />
    <SolidColorBrush x:Key="BrushText" Color="#E8EAED" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9AA0AA" />
    <SolidColorBrush x:Key="BrushAccent" Color="#3B82F6" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#60A5FA" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#2563EB" />
    <SolidColorBrush x:Key="BrushAccentText" Color="#0B1220" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#4ADE80" />
    <SolidColorBrush x:Key="BrushSuccessSurface" Color="#173425" />
    <SolidColorBrush x:Key="BrushDanger" Color="#F87171" />
    <SolidColorBrush x:Key="BrushSelection" Color="#24365E" />
    <SolidColorBrush x:Key="BrushRowAlt" Color="#23262C" />
    <SolidColorBrush x:Key="BrushDisabled" Color="#24272C" />
    <SolidColorBrush x:Key="BrushDisabledText" Color="#5B6068" />

</ResourceDictionary>
