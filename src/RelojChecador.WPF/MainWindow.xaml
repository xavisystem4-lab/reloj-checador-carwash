<Window x:Class="RelojChecador.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RelojChecador.WPF.Views"
        xmlns:converters="clr-namespace:RelojChecador.WPF.Converters"
        mc:Ignorable="d"
        Title="Reloj Checador" Height="650" Width="1000">
    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <!-- DataContext de la ventana = UpdateViewModel (para la barra inferior). Los
         controles hijo (BranchesViewControl/DevicesViewControl) tienen su PROPIO
         DataContext asignado explícitamente en el code-behind — eso anula la herencia
         normal de WPF para esos controles específicos, así que fijar el DataContext aquí
         no les afecta. -->
    <DockPanel>
        <!-- Barra superior — solo el interruptor de modo claro/oscuro (a pedido explícito:
             "me gustaría que la opción del modo oscuro estuviese arriba"). Separada de la
             barra inferior de versión/actualización a propósito: cambiar de tema es una
             preferencia de toda la sesión, distinta de "hay una actualización pendiente". -->
        <Border DockPanel.Dock="Top" Padding="14,8" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Reloj Checador" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" />
                <Button DockPanel.Dock="Right" x:Name="DarkModeToggleButton" Style="{StaticResource GhostButton}"
                        Click="OnToggleDarkModeClick" ToolTip="Cambiar entre modo claro y oscuro"
                        FontSize="16" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- Barra de versión / actualización / estado de la nube — visible siempre, sin
             importar la pestaña activa: ninguna de estas tres cosas es una operación de una
             pantalla en particular. -->
        <Border DockPanel.Dock="Bottom" Padding="14,8" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentVersionLabel}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,18,0" />
                <TextBlock Grid.Column="1" Text="{Binding CloudSyncStatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                           MaxWidth="360" Margin="0,0,10,0" ToolTip="{Binding CloudSyncStatusMessage}" />
                <Button Grid.Column="2" Content="Conectar con nube" Command="{Binding SyncCloudNowCommand}"
                        IsEnabled="{Binding IsCloudSyncBusy, Converter={StaticResource InverseBoolConverter}}"
                        ToolTip="Fuerza un ciclo de sincronización con Supabase ahora mismo, sin esperar el ciclo automático"
                        Margin="0,0,18,0" />
                <TextBlock Grid.Column="3" Text="{Binding UpdateStatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="4" Content="Actualizar versión" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CheckForUpdateCommand}" />
            </Grid>
        </Border>

        <!-- Navegación mínima por pestañas: solo Sucursales y Dispositivos existen por ahora.
             El resto de secciones (Empleados, Asistencia, Reportes...) del menú lateral
             definido en la Fase 3 todavía no están construidas. -->
        <TabControl Padding="4">
            <TabItem Header="Sucursales">
                <views:BranchesView x:Name="BranchesViewControl" />
            </TabItem>
            <TabItem Header="Dispositivos">
                <views:DevicesView x:Name="DevicesViewControl" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
