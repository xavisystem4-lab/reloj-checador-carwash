<Window x:Class="RelojChecador.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RelojChecador.WPF.Views"
        mc:Ignorable="d"
        Title="Reloj Checador" Height="650" Width="1000">
    <!-- Navegación mínima por pestañas: solo Sucursales y Dispositivos existen por ahora.
         El resto de secciones (Empleados, Asistencia, Reportes...) del menú lateral
         definido en la Fase 3 todavía no están construidas. -->
    <TabControl Padding="4">
        <TabItem Header="Sucursales">
            <views:BranchesView x:Name="BranchesViewControl" />
        </TabItem>
        <TabItem Header="Dispositivos">
            <views:DevicesView x:Name="DevicesViewControl" />
        </TabItem>
    </TabControl>
</Window>
