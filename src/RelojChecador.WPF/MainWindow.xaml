<Window x:Class="RelojChecador.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RelojChecador.WPF"
        mc:Ignorable="d"
        Title="Reloj Checador" Height="450" Width="800">
    <!-- Ventana mínima de arranque: confirma que DI + EF Core + SQLite local + binding
         funcionan de extremo a extremo. La navegación completa (Fase 3) se construye
         sobre esta misma base en una tarea posterior. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reloj Checador" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" />
    </Grid>
</Window>
