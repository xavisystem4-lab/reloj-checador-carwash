<Window x:Class="RelojChecador.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RelojChecador.WPF.Views"
        xmlns:converters="clr-namespace:RelojChecador.WPF.Converters"
        mc:Ignorable="d"
        Title="Reloj Checador" Height="650" Width="1000">
    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />

        <!-- Punto de estado de la nube — color según CloudSyncStatusKind ("Connected" =
             verde, "Error" = rojo, "Disabled"/"Syncing"/cualquier otro = gris neutro). Usa
             DynamicResource (no un color fijo) para que el punto respete el tema
             claro/oscuro activo. -->
        <Style x:Key="CloudStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{DynamicResource BrushTextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CloudSyncStatusKind}" Value="Connected">
                    <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CloudSyncStatusKind}" Value="Error">
                    <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- DataContext de la ventana = UpdateViewModel (para las barras superior e inferior).
         Los controles hijo (BranchesViewControl/DevicesViewControl) tienen su PROPIO
         DataContext asignado explícitamente en el code-behind — eso anula la herencia
         normal de WPF para esos controles específicos, así que fijar el DataContext aquí
         no les afecta. -->
    <DockPanel>
        <!-- Barra superior — modo claro/oscuro Y estado de la nube (ambos a pedido
             explícito: "me gustaría que la opción del modo oscuro estuviese arriba" /
             "coloca en la parte de arriba la conexión con la nube y que esté un indicador
             verde"). Separada de la barra inferior de versión/actualización a propósito:
             esto es estado "en vivo" de la sesión, distinto de "hay una actualización
             pendiente". -->
        <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Logotipo del negocio ("Drive In Car Wash") — pedido explícito del
                     usuario: "en la parte izquierda de arriba que haga contraste al tema
                     día y noche". Se monta sobre una tarjeta blanca fija (nunca
                     DynamicResource) a propósito: el logo trae colores oscuros (azul
                     marino) sobre fondo blanco opaco — en modo oscuro, puesto directo
                     sobre el fondo de la barra, se perdería casi por completo (mismo
                     error de contraste que ya se corrigió en el instalador, ver
                     v1.18.1). Una tarjeta blanca constante garantiza el mismo contraste
                     fuerte sin importar el tema activo. -->
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="6" Padding="8,4"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0">
                    <Image Source="Assets/DriveInLogo.png" Height="28" Stretch="Uniform"
                           ToolTip="Drive In Car Wash" />
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="Reloj Checador" FontWeight="Bold" FontSize="17"
                           VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" />
                <Button DockPanel.Dock="Right" x:Name="DarkModeToggleButton" Style="{StaticResource GhostButton}"
                        Click="OnToggleDarkModeClick" ToolTip="Cambiar entre modo claro y oscuro"
                        FontSize="16" HorizontalAlignment="Right" />
                <Button DockPanel.Dock="Right" Content="Conectar con nube" Command="{Binding SyncCloudNowCommand}"
                        IsEnabled="{Binding IsCloudSyncBusy, Converter={StaticResource InverseBoolConverter}}"
                        ToolTip="Fuerza un ciclo de sincronización con Supabase ahora mismo, sin esperar el ciclo automático"
                        Margin="0,0,14,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0"
                            ToolTip="{Binding CloudSyncStatusMessage}">
                    <Ellipse Style="{StaticResource CloudStatusDotStyle}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding CloudSyncShortStatus}" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Banner con el mensaje COMPLETO de error de sincronización (antes solo vivía en
             el ToolTip del punto rojo de arriba) — encontrado hoy mismo diagnosticando en
             vivo con el usuario "no sube nada a Supabase": el mismo comentario de
             RefreshCloudSyncStatusMessage ya advertía que ir por el error a punta de
             capturas de pantalla es lento, y en la práctica el ToolTip resultó peor
             todavía — en una sesión de control remoto (TeamViewer/AnyDesk y similares) el
             hover no siempre se transmite, así que ni el usuario podía ver su propio
             mensaje de error de forma confiable. Visible solo cuando de verdad hay un
             error (CloudSyncStatusKind == "Error") — el resto del tiempo no ocupa espacio
             ni compite con la barra de arriba. -->
        <Border DockPanel.Dock="Top" Padding="16,8" Background="{DynamicResource BrushDangerSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CloudSyncStatusKind}" Value="Error">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding CloudSyncStatusMessage}" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource BrushDanger}" />
        </Border>

        <!-- Barra de versión / actualización — visible siempre, sin importar la pestaña
             activa: buscar actualizaciones no es una operación de ninguna pantalla en
             particular. -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Pedido explícito del usuario: crédito de desarrollo a la izquierda de
                     la versión, siempre visible sin importar la pestaña activa (misma
                     barra de abajo que ya muestra versión/actualización). -->
                <TextBlock Grid.Column="0" Text="Desarrollado por SoftGala" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,18,0" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentVersionLabel}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,18,0" />
                <TextBlock Grid.Column="2" Text="{Binding UpdateStatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Content="Actualizar versión" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CheckForUpdateCommand}" />
            </Grid>
        </Border>

        <!-- Navegación por pestañas: Sucursales, Empleados, Dispositivos, Asistencia y
             Reportes (Fase 3 completa + el tramo acotado de Fases 5-6: horas trabajadas +
             insumo de nómina, sin cálculo fiscal). -->
        <!-- Íconos por pestaña (emoji, mismo criterio ya usado en el Dashboard web — sin
             assets nuevos que empaquetar) — pulido visual pedido explícitamente
             ("más moderno"), ayuda a ubicar la sección de un vistazo. -->
        <TabControl Padding="4">
            <TabItem Header="🏢 Sucursales">
                <views:BranchesView x:Name="BranchesViewControl" />
            </TabItem>
            <TabItem Header="👥 Empleados">
                <views:EmployeesView x:Name="EmployeesViewControl" />
            </TabItem>
            <TabItem Header="⏱️ Dispositivos">
                <views:DevicesView x:Name="DevicesViewControl" />
            </TabItem>
            <TabItem Header="📋 Asistencia">
                <views:AttendanceView x:Name="AttendanceViewControl" />
            </TabItem>
            <TabItem Header="💰 Reportes">
                <views:PayrollView x:Name="PayrollViewControl" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
