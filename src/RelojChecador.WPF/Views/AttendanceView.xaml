<UserControl x:Class="RelojChecador.WPF.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RelojChecador.WPF.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <converters:VerifyMethodToTextConverter x:Key="VerifyMethodToTextConverter" />
        <converters:PunchTypeToTextConverter x:Key="PunchTypeToTextConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Asistencia" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />

        <!-- Sucursal y fechas van al servidor al presionar "Actualizar"; Buscar filtra en
             memoria sobre lo ya cargado, sin recargar nada (ver AttendanceViewModel). -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,14,10">
                <TextBlock Text="Sucursal" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2" />
                <ComboBox Width="200" Padding="4" ItemsSource="{Binding BranchOptions}"
                          SelectedItem="{Binding SelectedBranchOption, Mode=TwoWay}" />
            </StackPanel>
            <!-- DatePicker en vez de TextBox — pedido explícito del usuario: "que tenga
                 función de calendario y escribirlo manual también". Un solo control ya da
                 las dos cosas: el botón del calendario desplegable Y el cuadro de texto
                 sigue editable a mano. Language="es-MX" fija el formato dd/mm/aaaa al
                 escribir a mano sin importar la configuración regional de Windows — mismo
                 criterio que el resto de la app (nunca depender del locale de la máquina). -->
            <StackPanel Margin="0,0,14,10">
                <TextBlock Text="Desde (dd/mm/aaaa)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2" />
                <DatePicker Width="130" Padding="4" Language="es-MX" SelectedDate="{Binding FromDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
                <TextBlock Text="Hasta (dd/mm/aaaa)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2" />
                <DatePicker Width="130" Padding="4" Language="es-MX" SelectedDate="{Binding ToDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,14,10">
                <TextBlock Text="Buscar empleado o PIN" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Width="220" Padding="4" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button Content="Actualizar" Style="{StaticResource PrimaryButton}" Click="OnRefreshClick" Margin="0,0,8,0" />
                <Button Content="⬇ Exportar CSV" Click="OnExportCsvClick" Margin="0,0,8,0" />
                <!-- Pedido explícito del usuario: registrar a alguien a quien se le
                     olvidó checar, sin depender del reloj físico. Se guarda como
                     AttendanceVerifyMethod.Manual y se sube al Dashboard/nube igual que
                     cualquier otra — nunca se escribe en la memoria del dispositivo (no
                     es técnicamente posible). -->
                <Button Content="+ Marcar asistencia manual" Click="OnCreateManualAttendanceClick" Margin="0,0,8,0" />
                <!-- Corrección de datos de una sola vez, no un filtro — pedido explícito
                     del usuario: "ahorita todas las checadas marcalas como entradas
                     normales incluso las que ya checaron", antes de que la clasificación
                     automática por 7h50 empiece a aplicar a las marcaciones nuevas (ver
                     AttendanceViewModel.NormalizePunchTypesAsync). -->
                <Button Content="🔧 Normalizar tipos de marcación" Click="OnNormalizePunchTypesClick" Margin="0,0,8,0" />
                <!-- Pedido explícito del usuario: "editarlo masivamente con un check,
                     escoger a los empleados y ponerle si es entrado o salida" — aplica a
                     todas las filas con el check de la columna "Sel." marcado (ver
                     BulkEditAttendanceDialog). -->
                <Button Content="✏️ Editar seleccionadas" Click="OnBulkEditClick" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding Attendances}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <!-- Checkbox de selección para "Editar seleccionadas" — pedido explícito del
                     usuario: "editarlo masivamente con un check". DataGridTemplateColumn con
                     un CheckBox explícito, NO DataGridCheckBoxColumn — este último tiene un
                     defecto conocido de WPF: el primer clic solo selecciona la celda, hace
                     falta un segundo clic para que el check realmente cambie (reportado por
                     el usuario: "no hace la función del check"). Un CheckBox de verdad
                     dentro de la plantilla recibe el clic directo sin ese intermediario. -->
                <DataGridTemplateColumn Header="Sel." Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Fecha y hora" Binding="{Binding Attendance.TimestampUtc, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="160" />
                <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeDisplay}" Width="*" />
                <DataGridTextColumn Header="Sucursal" Binding="{Binding BranchName}" Width="140" />
                <!-- Conserva la ubicación original de alguien fusionado a otra sucursal
                     (ver EmployeesViewModel.ApplyCatalogReplaceAsync) — pedido explícito del
                     usuario: "que en los reportes se acomoden por sucursal". -->
                <DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="120" />
                <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName}" Width="140" />
                <DataGridTextColumn Header="Método" Binding="{Binding Attendance.VerifyMethod, Converter={StaticResource VerifyMethodToTextConverter}}" Width="100" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Attendance.PunchType, Converter={StaticResource PunchTypeToTextConverter}}" Width="150" />
                <!-- "Nota en especial" — pedido explícito del usuario, capturada desde
                     "✏️ Editar" (ver EditAttendanceDialog). -->
                <DataGridTextColumn Header="Nota" Binding="{Binding Attendance.Notes}" Width="160" />
                <DataGridTemplateColumn Header="Acciones" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✏️ Editar" Style="{StaticResource PrimaryButton}"
                                    Padding="10,4" FontSize="12" Margin="4,2"
                                    HorizontalAlignment="Center" Click="OnEditAttendanceClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
