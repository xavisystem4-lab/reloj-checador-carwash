<Window x:Class="RelojChecador.WPF.Views.AttendanceRecordsFullDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:RelojChecador.WPF.Converters"
        Title="Asistencias descargadas — vista completa" Height="700" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <converters:PunchTypeToTextConverter x:Key="PunchTypeToTextConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderTextBlock" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <!-- Mismas columnas exactas que la vista embebida en Dispositivos — pedido
             explícito del usuario: "Ver Completo" que abra en su propia pantalla, sin el
             MaxHeight recortado del panel chico, y que se pueda maximizar. -->
        <DataGrid Grid.Row="1" x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PIN empleado" Binding="{Binding Record.DeviceUserPin}" Width="110" />
                <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeDisplay}" Width="200" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding PreviewPunchTypeDisplay}" Width="170" />
                <DataGridTextColumn Header="Fecha y hora" Binding="{Binding Record.TimestampUtc, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="170" />
                <DataGridTextColumn Header="Método" Binding="{Binding Record.VerifyMethod}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cerrar" Width="100" Click="OnCloseClick" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
