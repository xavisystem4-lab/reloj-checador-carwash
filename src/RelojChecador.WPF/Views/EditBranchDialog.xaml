<Window x:Class="RelojChecador.WPF.Views.EditBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar sucursal" Height="460" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Código *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="CodeTextBox" MaxLength="20" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Nombre *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="NameTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Zona horaria (IANA) *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="TimeZoneTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Razón social" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="LegalEntityNameTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Domicilio" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="AddressTextBox" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" Height="50" />
        </StackPanel>

        <CheckBox Grid.Row="5" x:Name="IsActiveCheckBox" Content="Sucursal activa" Margin="0,0,0,10" IsChecked="True" />

        <TextBlock Grid.Row="6" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
