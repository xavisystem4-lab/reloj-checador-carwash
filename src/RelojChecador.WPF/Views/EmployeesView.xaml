<UserControl x:Class="RelojChecador.WPF.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Empleados" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Nuevo empleado" Style="{StaticResource PrimaryButton}" Click="OnAddEmployeeClick" Margin="0,0,8,0" />
            <Button Content="⬆ Importar desde CSV" Click="OnImportEmployeesClick" Margin="0,0,8,0" />
            <!-- Distinto de "Importar desde CSV" a propósito: ese solo agrega gente nueva,
                 nunca toca a quien ya existe (regla explícita del usuario) — esto trata el
                 archivo como el catálogo COMPLETO (actualiza/crea/da de baja), pedido
                 explícito tras subir un catálogo más completo. -->
            <Button Content="🔁 Reemplazar catálogo" Click="OnReplaceCatalogClick" Margin="0,0,8,0" />
            <!-- Atajo directo del mismo botón que ya vivía dentro de "Reemplazar catálogo"
                 — pedido explícito del usuario para no tener que abrir ese diálogo primero
                 solo para bajar el modelo del archivo. Misma plantilla exacta en los dos
                 lados (ver EmployeeCatalogReplaceParser.SampleTemplateCsv). -->
            <Button Content="📄 Exportar plantilla" Click="OnExportTemplateClick" Margin="0,0,16,0" />
            <!-- Movido desde Dispositivos a pedido explícito del usuario — antes solo vivía
                 ahí y exigía tener ya un dispositivo seleccionado/conectado a mano. Este
                 botón conecta, envía y desconecta él solo (ver
                 EmployeesView.xaml.cs, OnSendEmployeesToDeviceClick). -->
            <Button Content="📤 Enviar empleados al reloj" Click="OnSendEmployeesToDeviceClick"
                    ToolTip="Envía Nombre + PIN (asignado en automático) de cada empleado activo de esta sucursal que aún no esté vinculado a ese reloj. Solo prepara el PIN — la huella se enrola físicamente en el dispositivo." />
            <!-- "Eliminar" es baja lógica (ver EmployeesViewModel.DeleteEmployeeAsync): el
                 empleado se oculta de la lista por defecto, no se borra — este checkbox
                 los vuelve a mostrar sin recargar la base de datos. -->
            <CheckBox Content="Mostrar dados de baja" VerticalAlignment="Center"
                      IsChecked="{Binding ShowTerminatedEmployees, Mode=TwoWay}" />
        </StackPanel>

        <!-- Filtros — pedido explícito del usuario para poder navegar el catálogo real
             (54+ empleados) sin desplazarse a mano por todo el DataGrid. Los tres se
             combinan entre sí y con "Mostrar dados de baja" de arriba (ver
             EmployeesViewModel.ApplyVisibilityFilter). -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Width="220" VerticalContentAlignment="Center" Margin="0,0,16,0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Sucursal:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox Width="200" Margin="0,0,16,0"
                      ItemsSource="{Binding BranchFilterOptions}"
                      SelectedItem="{Binding SelectedBranchFilter, Mode=TwoWay}" />
            <TextBlock Text="Estatus:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox Width="160" Margin="0,0,16,0"
                      ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
            <!-- Borrado FÍSICO y permanente (a diferencia de "Eliminar" por fila, que es
                 baja lógica) — pedido explícito del usuario para poder vaciar la lista
                 (completa o solo lo seleccionado) antes de importar un catálogo nuevo sin
                 conflictos. Abre DeleteEmployeesDialog, que deja elegir a quién con
                 checkboxes + "Seleccionar todo" y pide confirmación con el conteo exacto
                 antes de aplicar (ver EmployeesViewModel.HardDeleteEmployeesAsync). -->
            <Button Content="🗑️ Borrar" Foreground="{DynamicResource BrushDanger}" Click="OnDeleteEmployeesClick" />
        </StackPanel>

        <!-- Bindea a EmployeeRow (Employee + BranchName ya resuelto), no a Employee
             directo — Employee solo guarda BranchId, sin navegación a Branch. -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Employee.Number}" Width="90" />
                <DataGridTextColumn Header="PIN" Binding="{Binding PinSummary}" Width="60" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Employee.FullName}" Width="*" />
                <DataGridTextColumn Header="Sucursal" Binding="{Binding BranchName}" Width="150" />
                <DataGridTextColumn Header="Departamento" Binding="{Binding Employee.Department}" Width="130" />
                <DataGridTextColumn Header="Puesto" Binding="{Binding Employee.Position}" Width="130" />
                <DataGridTextColumn Header="Fecha de alta" Binding="{Binding Employee.HireDate, StringFormat='dd/MM/yyyy'}" Width="110" />
                <DataGridTextColumn Header="Estatus" Binding="{Binding Employee.Status}" Width="90" />
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Employee.Phone}" Width="110" />
                <DataGridTextColumn Header="Correo" Binding="{Binding Employee.Email}" Width="160" />
                <DataGridTextColumn Header="Dispositivos vinculados" Binding="{Binding LinkedDevicesSummary}" Width="220" />
                <DataGridTemplateColumn Header="" Width="480">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- El DataContext de estos botones es el EmployeeRow de la fila
                                 (heredado automáticamente dentro de la plantilla de celda),
                                 así que cada handler en code-behind lo lee directo sin Tag. -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                                        Click="OnEditEmployeeClick" />
                                <Button Content="Vincular a dispositivo" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                                        Click="OnLinkDeviceClick" />
                                <!-- Corrige el PIN de un vínculo YA existente (p. ej. si se
                                     capturó mal) — "Vincular a dispositivo" solo sirve para
                                     agregar vínculos nuevos, nunca editar uno existente. -->
                                <Button Content="Editar vínculo(s)" Padding="8,4" FontSize="12" Margin="0,0,6,0"
                                        Click="OnEditMappingsClick" />
                                <Button Content="Eliminar" Padding="8,4" FontSize="12"
                                        Click="OnDeleteEmployeeClick" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
