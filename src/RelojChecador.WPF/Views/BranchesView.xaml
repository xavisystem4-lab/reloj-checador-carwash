<UserControl x:Class="RelojChecador.WPF.Views.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sucursales" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Nueva sucursal" Style="{StaticResource PrimaryButton}" Margin="0,0,16,0" Click="OnAddBranchClick" />
            <Button Content="⬇ Exportar CSV" Margin="0,0,8,0" Click="OnExportCsvClick" />
            <!-- Un solo botón cubre "exportar a PDF" e "imprimir": abre el PrintDialog
                 nativo de Windows, donde el driver virtual "Microsoft Print to PDF"
                 (incluido de fábrica en Windows 10/11) guarda como PDF sin instalar nada,
                 o se puede elegir cualquier impresora física — cero dependencias nuevas
                 en el .exe self-contained. -->
            <Button Content="🖶 Imprimir / Exportar PDF" Margin="0,0,8,0" Click="OnPrintClick" />
            <!-- Borrado FÍSICO y permanente (a diferencia de "Eliminar" por fila, que es
                 baja lógica) — pedido explícito del usuario para consolidar varias
                 sucursales de prueba en una sola, reasignando automáticamente sus
                 empleados/dispositivos/marcaciones (ver DeleteBranchesDialog y
                 MainViewModel.HardDeleteBranchesAsync). -->
            <Button Content="🗑️ Borrar" Foreground="{DynamicResource BrushDanger}" Margin="0,0,16,0" Click="OnDeleteBranchesClick" />
            <!-- "Eliminar" es baja lógica (ver MainViewModel.DeleteBranchAsync): la sucursal
                 se oculta de la lista por defecto, no se borra — este checkbox la vuelve a
                 mostrar sin recargar la base de datos, mismo criterio que "Mostrar
                 deshabilitados" en Dispositivos y "Mostrar dados de baja" en Empleados. -->
            <CheckBox Content="Mostrar sucursales inactivas" VerticalAlignment="Center" FontSize="12.5"
                      IsChecked="{Binding ShowInactiveBranches, Mode=TwoWay}" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Branches}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Zona horaria" Binding="{Binding TimeZoneId}" Width="180" />
                <DataGridTextColumn Header="Razón social" Binding="{Binding LegalEntityName}" Width="200" />
                <!-- Mode=OneWay explícito: aunque el DataGrid ya es IsReadOnly, DataGridCheckBoxColumn
                     arma el binding del CheckBox interno (IsChecked) como TwoWay por defecto sin importar
                     eso, y falla al cargar la tabla porque Branch.IsActive es de solo lectura en el
                     dominio (sin setter público) — ver App.xaml.cs ReportFatal, InvalidOperationException
                     "Un enlace TwoWay u OneWayToSource no puede funcionar en la propiedad de sólo
                     lectura 'IsActive'" reportado la primera vez que corrió en Windows real. -->
                <DataGridCheckBoxColumn Header="Activa" Binding="{Binding IsActive, Mode=OneWay}" Width="70" />
                <DataGridTemplateColumn Header="" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- DataContext heredado = la Branch de la fila (mismo patrón
                                 que EmployeesView/PayrollView) — cada handler la lee directo
                                 sin Tag. -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Padding="8,4" FontSize="12" Margin="0,0,6,0" Click="OnEditBranchClick" />
                                <Button Content="🗑️ Eliminar" Padding="8,4" FontSize="12" Click="OnDeleteBranchClick" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
