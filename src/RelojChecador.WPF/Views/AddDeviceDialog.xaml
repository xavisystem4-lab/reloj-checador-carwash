<Window x:Class="RelojChecador.WPF.Views.AddDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo dispositivo" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Nombre descriptivo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="NameTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Sucursal *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="BranchComboBox" Padding="4" DisplayMemberPath="Name" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Marca *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="BrandTextBox" Text="ZKTeco" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Modelo *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="ModelTextBox" Text="F22/ID" Padding="4" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Dirección IP *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="IpTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Puerto TCP *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="PortTextBox" Text="4370" Padding="4" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Número de serie" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="SerialTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Dirección MAC" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="MacTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Clave de comunicación (opcional)" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock Text="Algunos equipos la exigen para conectar (Connect_Net). Se guarda cifrada en Windows, nunca en la base de datos." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4" />
            <PasswordBox x:Name="CommunicationKeyPasswordBox" Padding="4" />
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
