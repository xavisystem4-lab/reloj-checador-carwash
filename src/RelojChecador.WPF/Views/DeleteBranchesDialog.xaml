<Window x:Class="RelojChecador.WPF.Views.DeleteBranchesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borrar sucursales" Height="600" Width="760"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🗑️ Borrar sucursales" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrushDanger}" Margin="0,0,0,10">
            Esto BORRA de verdad las sucursales marcadas (no es la baja lógica normal). Sus empleados,
            dispositivos y marcaciones de asistencia se REASIGNAN automáticamente a la sucursal destino que
            elijas abajo — nadie se borra ni se da de baja. Si un empleado no tenía capturado un
            Departamento, ahí se guarda el nombre de su sucursal original, para no perder ese dato en los
            reportes. No se puede deshacer.
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Sucursal destino (donde se queda todo):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="TargetBranchComboBox" Width="220" DisplayMemberPath="Name" SelectionChanged="OnTargetBranchChanged" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="SelectAllCheckBox" Content="Seleccionar todo" VerticalAlignment="Center"
                      Margin="0,0,16,0" Checked="OnSelectAllChanged" Unchecked="OnSelectAllChanged" />
            <TextBlock x:Name="SelectedCountTextBlock" Text="0 seleccionada(s) de 0" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>

        <DataGrid Grid.Row="4" x:Name="BranchesGrid" ItemsSource="{Binding}" AutoGenerateColumns="False"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <!-- Ver comentario equivalente en DeleteEmployeesDialog: CheckBox real en
                     una plantilla, no DataGridCheckBoxColumn, para que un solo clic marque. -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}"
                                      HorizontalAlignment="Center" Click="OnRowCheckedChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Código" Binding="{Binding Branch.Code}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Branch.Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Activa" Binding="{Binding Branch.IsActive}" Width="70" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="DeleteButton" Content="Borrar seleccionadas" Width="220"
                    Foreground="{DynamicResource BrushDanger}" FontWeight="Bold"
                    Click="OnDeleteClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
