<Window x:Class="RelojChecador.WPF.Views.EditPayrollDeductionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar deducciones" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderTextBlock" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="1"
                   Text="Montos que ya calculaste por fuera (tú o tu contador) — el sistema nunca calcula ISR/IMSS, solo resta lo que captures aquí del pago bruto."
                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Grid.Row="2" Text="ISR" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
        <TextBox Grid.Row="3" x:Name="IsrTextBox" Padding="6" Margin="0,0,0,10" />

        <TextBlock Grid.Row="4" Text="IMSS" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
        <TextBox Grid.Row="5" x:Name="ImssTextBox" Padding="6" Margin="0,0,0,10" />

        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Otro (monto)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
                <TextBox x:Name="OtherAmountTextBox" Padding="6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Concepto de &quot;Otro&quot; (opcional)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
                <TextBox x:Name="OtherLabelTextBox" Padding="6" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="7" Text="Notas (opcional)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" />
        <TextBox Grid.Row="8" x:Name="NotesTextBox" Padding="6" TextWrapping="Wrap" AcceptsReturn="True"
                 Height="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

        <TextBlock Grid.Row="10" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
