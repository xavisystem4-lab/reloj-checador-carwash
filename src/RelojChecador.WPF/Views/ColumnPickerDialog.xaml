<Window x:Class="RelojChecador.WPF.Views.ColumnPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalizar columnas" Height="560" Width="380"
        MinHeight="360" MinWidth="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12">
            Marca las columnas que quieres ver y usa ▲▼ para acomodar el orden en que aparecen.
        </TextBlock>

        <ListBox Grid.Row="1" x:Name="ColumnsListBox" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="▲" Width="28" Margin="0,0,4,0"
                                Tag="{Binding}" Click="OnMoveUpClick" />
                        <Button Grid.Column="3" Content="▼" Width="28"
                                Tag="{Binding}" Click="OnMoveDownClick" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <!-- Vuelve al orden/visibilidad original del XAML — pedido implícito de tener
                 "una salida" si el reacomodo queda mal, sin depender de desmarcar/mover cada
                 columna a mano de vuelta. -->
            <Button Content="Restablecer" Click="OnResetClick" Margin="0,0,8,0" />
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Aplicar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnApplyClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
