<Window x:Class="RelojChecador.WPF.Views.EditAttendanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar marcación" Height="460" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Empleado" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock x:Name="EmployeeTextBlock" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Fecha y hora ahora editables — pedido explícito del usuario: "también podamos
             editar la hora ... el empleado llegó temprano, pero checó hasta ahorita ...
             necesitamos colocar que a la hora en que llegó, que no afecte". Mismo criterio
             que "Marcar asistencia manual": DatePicker con Language="es-MX" (calendario Y
             texto a mano) + hora en cualquier formato (FlexibleTimeParser). -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Fecha * (dd/mm/aaaa)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <DatePicker x:Name="DatePickerControl" Padding="4" Language="es-MX" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hora *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="TimeTextBox" Padding="4" ToolTip="Cualquier formato: 08:00, 8:00 AM, 20:00…" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Tipo *" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton x:Name="EntradaRadioButton" Content="Entrada" GroupName="PunchType" Margin="0,0,16,0" />
            <RadioButton x:Name="SalidaRadioButton" Content="Salida" GroupName="PunchType" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Nota (opcional)" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="NotesTextBox" Padding="4" TextWrapping="Wrap" AcceptsReturn="True"
                     Height="70" VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,10" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Borrado físico — pedido explícito del usuario: "o eliminar Marcación".
                 Separado a la izquierda a propósito, para no quedar pegado a
                 Cancelar/Guardar y prestarse a un clic accidental. -->
            <Button Grid.Column="0" Content="🗑 Eliminar marcación" HorizontalAlignment="Left"
                    Foreground="{DynamicResource BrushDanger}" Click="OnDeleteClick" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
                <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
