<Window x:Class="RelojChecador.WPF.Views.RecoverClockPunchesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traer marcaciones del reloj" Height="640" Width="1080"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📥 Traer marcaciones del reloj" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="DownloadSummaryTextBlock" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10">
            Personas que checaron en el reloj pero no aparecen en el sistema: sus marcaciones son de un empleado dado
            de baja o de nadie. Elige qué hacer con cada PIN. "Reactivar" lo vuelve a dar de alta con el siguiente
            número libre (EMP-055, EMP-056…) y conserva todo su historial. Si en realidad es alguien que ya está en el
            catálogo con otro nombre, elígelo en la lista. Vienen marcados los que checaron en los últimos 30 días.
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="SelectAllCheckBox" Content="Seleccionar todo" VerticalAlignment="Center"
                      Margin="0,0,16,0" Checked="OnSelectAllChanged" Unchecked="OnSelectAllChanged" />
            <TextBlock x:Name="SelectedCountTextBlock" Text="0 seleccionado(s) de 0" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>

        <DataGrid Grid.Row="4" x:Name="PinsGrid" AutoGenerateColumns="False"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <!-- CheckBox real en plantilla, no DataGridCheckBoxColumn: un solo clic marca/desmarca. -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" Click="OnRowCheckedChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PIN" Binding="{Binding Pin.Pin}" Width="55" IsReadOnly="True" />
                <DataGridTextColumn Header="Quién checó" Binding="{Binding WhoDisplay}" Width="200" IsReadOnly="True" />
                <DataGridTextColumn Header="Marcaciones" Binding="{Binding Pin.AttendanceCount}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Última vez" Binding="{Binding LastSeenLocal, StringFormat='dd/MM/yyyy HH:mm'}" Width="120" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Qué hacer" Width="*" MinWidth="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Display" IsEditable="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="220" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cerrar" Width="100" Margin="0,0,8,0" Click="OnCloseClick" IsCancel="True" />
            <Button x:Name="ApplyButton" Content="Traer seleccionados al sistema" Width="240"
                    Style="{StaticResource PrimaryButton}" Click="OnApplyClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
