<Window x:Class="RelojChecador.WPF.Views.ImportEmployeesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar empleados desde CSV" Height="640" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Importar empleados desde CSV" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Solo crea empleados NUEVOS — nunca sobreescribe uno que ya exista (se omite y se avisa). Columnas esperadas: Number,FullName,Area,Position,WeeklySalary,OvertimeHourlyRate,Notes — los últimos cuatro pueden ir vacíos."
                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <Button Grid.Row="2" Content="📂 Seleccionar archivo CSV..." Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Margin="0,0,0,12" Click="OnSelectFileClick" />

        <TextBlock Grid.Row="3" x:Name="SummaryTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <TextBlock Grid.Row="4" x:Name="BranchesTextBlock" Foreground="{DynamicResource BrushAccent}"
                   TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <TextBlock Grid.Row="5" x:Name="ErrorsTextBlock" Foreground="{DynamicResource BrushDanger}"
                   TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

        <DataGrid Grid.Row="6" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="0,0,0,14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Row.Number}" Width="90" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Row.FullName}" Width="*" />
                <DataGridTextColumn Header="Área" Binding="{Binding Row.Area}" Width="110" />
                <DataGridTextColumn Header="Puesto" Binding="{Binding Row.Position}" Width="130" />
                <DataGridTextColumn Header="Sueldo semanal" Binding="{Binding Row.WeeklySalary, StringFormat='{}{0:C}'}" Width="110" />
                <DataGridTextColumn Header="Hora extra" Binding="{Binding Row.OvertimeHourlyRate, StringFormat='{}{0:C}'}" Width="90" />
                <DataGridTextColumn Header="Alertas" Binding="{Binding AlertsText}" Width="260" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="ImportButton" Content="Importar" Width="220" Style="{StaticResource PrimaryButton}"
                    Click="OnImportClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
