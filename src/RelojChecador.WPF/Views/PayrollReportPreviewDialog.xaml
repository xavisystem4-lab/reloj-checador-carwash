<Window x:Class="RelojChecador.WPF.Views.PayrollReportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa — Reporte de nómina" Height="740" Width="1120"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <DockPanel>
        <!-- Pedido explícito del usuario: la misma previsualización tipo hoja con logo que
             ya quedó en el Dashboard web, con Imprimir/Exportar Excel/Exportar PDF arriba. -->
        <Grid DockPanel.Dock="Top" Background="{DynamicResource BrushSurface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="🖨️ Imprimir" Style="{StaticResource PrimaryButton}" Click="OnPrintClick" Margin="0,0,8,0" />
                    <Button Content="📊 Exportar Excel" Click="OnExportExcelClick" Margin="0,0,8,0" />
                    <Button Content="📄 Exportar PDF" Click="OnExportPdfClick" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Button Content="✕ Cerrar" Click="OnCloseClick" />
            </Border>
        </Grid>

        <!-- Fondo gris alrededor de la hoja (como un escritorio) — mismo criterio visual
             que report-preview-scroll de la web. IsToolBarVisible="False" porque los
             botones de arriba ya cubren Imprimir/zoom; el propio de WPF duplicaría eso. -->
        <Border Background="#5B6472">
            <FlowDocumentScrollViewer x:Name="DocumentViewer" Margin="24" Zoom="100"
                                      IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
