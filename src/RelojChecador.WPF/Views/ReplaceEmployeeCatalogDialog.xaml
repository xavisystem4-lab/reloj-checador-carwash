<Window x:Class="RelojChecador.WPF.Views.ReplaceEmployeeCatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reemplazar catálogo de empleados" Height="760" Width="980"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reemplazar catálogo de empleados" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10">
            A diferencia de "Importar desde CSV" (que solo agrega gente nueva), esto trata el archivo como
            el catálogo COMPLETO: actualiza a quien ya existe y coincide por nombre, crea a quien es nuevo,
            y da de baja (lógica, nunca borra — conserva historial y vínculos al reloj) a quien ya no
            aparece. La coincidencia es por NOMBRE EXACTO — revisa con cuidado la lista de "Se dará de baja"
            antes de aplicar. Columnas esperadas:
            Number,FullName,Area,Position,HireDate,Status,WeeklySalary,OvertimeHourlyRate,Notes,Pin
            (HireDate en AAAA-MM-DD, opcional; Status "Activo"/"Inactivo", opcional = Activo; Pin solo
            dígitos, opcional — si viene, vincula a esa persona con el reloj de su sucursal y, al darle
            después "Enviar empleados al reloj" en Empleados, ese PIN se sube de verdad al dispositivo).
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="📂 Seleccionar archivo..." Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0" Click="OnSelectFileClick" />
            <Button Content="📄 Exportar plantilla" Click="OnExportTemplateClick" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">
                Nombres a conservar aunque NO estén en el archivo (uno por línea)
            </TextBlock>
            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4">
                Para alguien dado de alta directo en el reloj que nunca pasó por ningún catálogo — se queda
                exactamente como está, sin darse de baja. Escribe el nombre TAL CUAL aparece hoy en la
                lista de Empleados.
            </TextBlock>
            <TextBox x:Name="ProtectedNamesTextBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="6" />
            <Button Content="🔄 Recalcular vista previa" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnRecalculateClick" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="SummaryTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <TextBlock Grid.Row="5" x:Name="BranchesTextBlock" Foreground="{DynamicResource BrushAccent}"
                   TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <TextBlock Grid.Row="6" x:Name="ErrorsTextBlock" Foreground="{DynamicResource BrushDanger}"
                   TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Se creará / actualizará" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="80" />
                        <DataGridTextColumn Header="Número" Binding="{Binding Row.Number}" Width="80" />
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Row.FullName}" Width="*" />
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding Row.Area}" Width="120" />
                        <DataGridTextColumn Header="Puesto" Binding="{Binding Row.Position}" Width="110" />
                        <DataGridTextColumn Header="Ingreso" Binding="{Binding Row.HireDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="90" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Row.Status}" Width="70" />
                        <DataGridTextColumn Header="PIN" Binding="{Binding Row.Pin}" Width="60" />
                        <DataGridTextColumn Header="Alertas" Binding="{Binding AlertsText}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="RemovalTitleTextBlock" Text="Se dará de baja" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid x:Name="RemovalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Se dará de baja" Binding="{Binding DisplayText}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="ApplyButton" Content="Aplicar" Width="260" Style="{StaticResource PrimaryButton}"
                    Click="OnApplyClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
