<Window x:Class="RelojChecador.WPF.Views.EditDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar dispositivo" Height="640" Width="440"
        MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <!-- ScrollViewer alrededor de todo el contenido: con texto grande de Windows (DPI/
         accesibilidad) o al agregar más campos con el tiempo, un diálogo de alto fijo sin
         esto recorta silenciosamente lo de más abajo (el botón "Guardar" incluido) en vez de
         mostrar una barra de scroll — bug real reportado por el usuario en un diálogo
         hermano (AddBranchDialog). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Nombre descriptivo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="NameTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Sucursal *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="BranchComboBox" Padding="4" DisplayMemberPath="Name" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Marca *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="BrandTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Modelo *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="ModelTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Dirección IP *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="IpTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Puerto TCP *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="PortTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Número de serie" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="SerialTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Dirección MAC" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="MacTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Clave de comunicación (opcional)" FontWeight="SemiBold" Margin="0,0,0,2" />
            <!-- Indicador de si ya hay una clave guardada — antes la pantalla no decía nada
                 al respecto, así que no había forma de saber si el dispositivo tenía una sin
                 abrir Windows Credential Manager a mano. x:Name en vez de binding: este
                 diálogo no usa MVVM, se llena en el code-behind (ver constructor). -->
            <TextBlock x:Name="CommunicationKeyStatusTextBlock" FontSize="11.5" FontStyle="Italic" Margin="0,0,0,4" />
            <TextBlock Text="Déjala en blanco para no cambiar la que ya está guardada. Se guarda cifrada en Windows, nunca en la base de datos." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4" />
            <PasswordBox x:Name="CommunicationKeyPasswordBox" Padding="4" />
            <!-- Pedido explícito del usuario: antes solo se podía REEMPLAZAR la clave
                 (escribiendo una nueva) — dejar el campo en blanco nunca la borraba, así que
                 no había ninguna forma de quitarla del todo. Checkbox aparte, no un botón,
                 para que "Cancelar" siga deshaciendo la intención de borrar igual que
                 cualquier otro campo del formulario. Se deshabilita solo si no hay ninguna
                 clave que borrar (ver constructor) y se excluye mutuamente con escribir una
                 nueva (ver OnCommunicationKeyPasswordChanged en el code-behind). -->
            <CheckBox x:Name="DeleteCommunicationKeyCheckBox" Content="Eliminar la clave guardada (dejar el dispositivo sin clave de comunicación)"
                      Margin="0,8,0,0" FontSize="12.5" Checked="OnDeleteCommunicationKeyChecked" />
        </StackPanel>

        <TextBlock Grid.Row="7" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
