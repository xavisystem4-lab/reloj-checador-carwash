<UserControl x:Class="RelojChecador.WPF.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RelojChecador.WPF.Converters"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="950">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsedConverter" />
        <converters:PunchTypeToTextConverter x:Key="PunchTypeToTextConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibleConverter" />
        <!-- BasedOn el estilo global de Button (Themes/Styles.xaml) — sin esto, el botón
             quedaría con el chrome nativo de Windows en vez del look plano moderno, porque
             un estilo local con clave (x:Key) no hereda el estilo implícito por su cuenta. -->
        <Style TargetType="Button" x:Key="ActionButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dispositivos" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: lista de dispositivos -->
            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Top" Content="+ Nuevo dispositivo" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                        HorizontalAlignment="Stretch" Click="OnAddDeviceClick" />
                <!-- "Eliminar" es baja lógica (ver DevicesViewModel.DeleteDeviceAsync): el
                     dispositivo se oculta de la lista por defecto, no se borra — este
                     checkbox lo vuelve a mostrar sin recargar la base de datos, mismo
                     criterio que "Mostrar dados de baja" en Empleados. -->
                <CheckBox DockPanel.Dock="Top" Content="Mostrar deshabilitados" Margin="0,0,0,10" FontSize="12.5"
                          IsChecked="{Binding ShowDisabledDevices, Mode=TwoWay}" />
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding IpAddress, Mode=OneWay}" />
                                    <Run Text=":" />
                                    <Run Text="{Binding TcpPort, Mode=OneWay}" />
                                </TextBlock>
                                <!-- Pedido explícito del usuario: editar/eliminar accesibles
                                     directo desde la lista, sin tener que seleccionar el
                                     dispositivo y bajar hasta el panel de diagnóstico de la
                                     derecha. El DataContext de estos botones es el Device de
                                     la fila (heredado dentro de la plantilla), igual patrón
                                     que los botones por fila de EmployeesView. -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="✏️ Editar" Padding="6,3" FontSize="11.5" Margin="0,0,6,0"
                                            Click="OnEditDeviceListItemClick" />
                                    <Button Content="🗑️ Eliminar" Padding="6,3" FontSize="11.5"
                                            Click="OnDeleteDeviceListItemClick" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Columna derecha: diagnóstico del dispositivo seleccionado -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding SelectedDevice, Converter={StaticResource NullToCollapsedConverter}}">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedDevice.Brand}" Foreground="{DynamicResource BrushTextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedDevice.Model}" Foreground="{DynamicResource BrushTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <!-- Estado real de conexión, siempre visible (a diferencia del panel
                             "Diagnóstico de conexión" de abajo, que solo se actualiza al
                             correr los 5 niveles a mano) — refleja IsConnected en vivo, la
                             misma propiedad que decide qué se sube a Supabase y ve el
                             Dashboard, así que esta pastilla nunca debería contradecirlo.
                             Pedido explícito del usuario: que la app avise "Desconectado" en
                             cuanto se interrumpa la comunicación, no solo hasta que alguien
                             note los checkmarks viejos del diagnóstico. -->
                        <Border CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushDangerSurface}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccessSurface}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔴 Desconectado" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="🟢 Conectado" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Background="{DynamicResource BrushSuccessSurface}" CornerRadius="10" Padding="8,3" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMonitoringRealTime, Converter={StaticResource BoolToVisibleConverter}}">
                            <TextBlock Text="🟢 En vivo — las marcaciones nuevas aparecen solas" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource BrushTextSecondary}">
                        <Run Text="{Binding SelectedDevice.IpAddress, Mode=OneWay}" />
                        <Run Text=":" />
                        <Run Text="{Binding SelectedDevice.TcpPort, Mode=OneWay}" />
                    </TextBlock>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource ActionButton}" Content="✏️ Editar dispositivo" Click="OnEditDeviceClick" />
                        <Button Style="{StaticResource ActionButton}" Content="Hacer ping" Command="{Binding PingCommand}" />
                        <Button Style="{StaticResource ActionButton}" Content="Probar puerto TCP" Command="{Binding TestPortCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Content="Conectar" Command="{Binding ConnectCommand}" />
                        <Button Style="{StaticResource ActionButton}" Content="Desconectar" Command="{Binding DisconnectCommand}" />
                        <Button Style="{StaticResource ActionButton}" Content="Consultar información" Command="{Binding GetDeviceInfoCommand}" />
                        <Button Style="{StaticResource ActionButton}" Content="👥 Usuarios del reloj" Click="OnDeviceUsersClick"
                                ToolTip="Ver, editar o eliminar (individual o en lote) quién está dado de alta directamente en la memoria del dispositivo" />
                        <Button Style="{StaticResource ActionButton}" Content="Descargar asistencias" Command="{Binding DownloadAttendanceCommand}" />
                        <Button Style="{StaticResource ActionButton}" Content="Sincronizar hora" Command="{Binding SyncDeviceTimeCommand}"
                                ToolTip="Escribe la hora de esta PC en el reloj del dispositivo" />
                        <!-- "📤 Enviar empleados al reloj" se movió a la pestaña Empleados
                             (pedido explícito del usuario) — ahí conecta/envía/desconecta
                             solo, sin depender de que ya estés en esta pestaña con un
                             dispositivo seleccionado y conectado a mano. -->
                    </WrapPanel>

                    <GroupBox Header="Diagnóstico de conexión (5 niveles — nunca se asume éxito sin probar)">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1. IP válida" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding IpValidResult}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2. Ping (ICMP)" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding PingResult}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="3. Puerto TCP" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding PortResult}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="4. Protocolo reconocido" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ProtocolResult}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="5. Autenticación" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding AuthResult}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Información del dispositivo (tras 'Consultar información')">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Número de serie" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InfoSerialNumber}" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Firmware" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InfoFirmwareVersion}" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Plataforma" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InfoPlatform}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Algoritmo de huella" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InfoFingerprintAlgorithm}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Usuarios registrados" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InfoUserCount}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Registros en el reloj" FontWeight="SemiBold" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding InfoAttendanceLogCount}" Margin="0,2" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Asistencias descargadas (esta sesión, aún sin conciliar/persistir)">
                        <DataGrid ItemsSource="{Binding AttendanceRecords}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" MaxHeight="180" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PIN empleado" Binding="{Binding DeviceUserPin}" Width="100" />
                                <DataGridTextColumn Header="Fecha y hora" Binding="{Binding TimestampUtc, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="150" />
                                <DataGridTextColumn Header="Método" Binding="{Binding VerifyMethod}" Width="100" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding PunchType, Converter={StaticResource PunchTypeToTextConverter}}" Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Bitácora">
                        <ListBox ItemsSource="{Binding LogEntries}" MaxHeight="140" BorderThickness="0" />
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
