<Window x:Class="RelojChecador.WPF.Views.CreateManualAttendanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marcar asistencia manual" Height="480" Width="420"
        MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Marcar asistencia manual" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12">
                Para cuando a alguien se le olvidó checar. Se guarda como marcación "Manual" (no una huella
                real) y se sube al Dashboard/nube igual que cualquier otra — nunca se escribe en la memoria
                del reloj físico, eso no es posible.
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Empleado *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="EmployeeComboBox" Padding="4" DisplayMemberPath="FullName" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <!-- Language="es-MX" fija el formato dd/mm/aaaa al escribir a mano y al
                     mostrar la fecha ya elegida, sin importar la configuración regional de
                     Windows — mismo criterio que el resto de la app (ver AttendanceView.xaml,
                     "que tenga función de calendario y escribirlo manual también"). Sin esto
                     el control cae al locale de la máquina y puede mostrar m/d/aaaa. -->
                <TextBlock Text="Fecha * (dd/mm/aaaa)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <DatePicker x:Name="DatePickerControl" Padding="4" Language="es-MX" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hora (HH:mm) *" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="TimeTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Tipo *" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton x:Name="EntradaRadioButton" Content="Entrada" GroupName="PunchType" IsChecked="True" Margin="0,0,16,0" />
            <RadioButton x:Name="SalidaRadioButton" Content="Salida" GroupName="PunchType" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Guardar" Width="100" Style="{StaticResource PrimaryButton}"
                    Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
