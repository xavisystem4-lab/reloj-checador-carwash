<Window x:Class="RelojChecador.WPF.Views.LinkEmployeeDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular a dispositivo" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderTextBlock" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Dispositivo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="DeviceComboBox" Padding="4" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="PIN en el dispositivo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <!-- Se escribe a mano: el usuario lo ve en la pantalla física del reloj o en
                 "Consultar información" de Dispositivos — no se conecta al dispositivo
                 aquí para descargarlo (decisión de alcance de esta entrega). -->
            <TextBox x:Name="PinTextBox" MaxLength="50" Padding="4" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Vincular" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
