<Window x:Class="RelojChecador.WPF.Views.EditEmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar empleado" Height="960" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fecha de alta no es editable a propósito: el dominio no expone un método para
             cambiarla (Employee.cs) — Número sí, desde que se agregó Employee.ChangeNumber
             a pedido del usuario, para corregir errores de captura del alta. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Número de empleado *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="NumberTextBox" MaxLength="20" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Nombre completo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="FullNameTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Sucursal *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="BranchComboBox" Padding="4" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Estatus *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="StatusComboBox" Padding="4" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Departamento" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="DepartmentTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Puesto" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="PositionTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <!-- Insumo de nómina sin ningún cálculo fiscal (ISR/IMSS) — ver
             EmployeesViewModel/WorkedHoursCalculator. Tarifa de hora extra es opcional:
             solo aplica si al empleado le corresponden horas extra. -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Sueldo semanal" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="WeeklySalaryTextBox" Padding="4" ToolTip="Déjalo vacío si el sueldo todavía no está confirmado — nunca se asume $0." />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tarifa hora extra" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="OvertimeHourlyRateTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="PhoneTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Correo" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="EmailTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <!-- Horario esperado (entrada Y salida) — pedido explícito del usuario: "que en
             Empleados me aparezcan sus horarios". Puramente informativo/de reporte por
             ahora: NO alimenta la regla de las 7h50 para "salida de turno" (ver
             ShiftPunchTypeClassifier), que cuenta desde la primera checada real del día,
             no desde este horario capturado — pedido explícito también. Ambos vacíos = sin
             capturar (Employee.UpdateSchedule no acepta uno solo). -->
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Hora de entrada (opcional, HH:mm)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="ScheduledStartTimeTextBox" Padding="4" ToolTip="Ej.: 08:00. Déjalo vacío junto con la hora de salida si el horario todavía no está definido." />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hora de salida (opcional, HH:mm)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="ScheduledEndTimeTextBox" Padding="4" ToolTip="Ej.: 16:00." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="8" Margin="0,0,0,10">
            <TextBlock Text="Notas (opcional)" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="NotesTextBox" Padding="4" TextWrapping="Wrap" AcceptsReturn="True"
                     Height="50" VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <!-- Solo se muestra si el empleado TODAVÍA no tiene ningún dispositivo vinculado
             (ver code-behind) — si ya tiene uno o más, agregar otro se sigue haciendo con
             el botón "Vincular a dispositivo" de la lista, para no meter aquí la
             complejidad de editar/quitar vínculos existentes. -->
        <StackPanel Grid.Row="9" x:Name="LinkDeviceSection" Margin="0,0,0,6">
            <CheckBox x:Name="LinkDeviceCheckBox" Content="Vincular a un reloj checador ahora"
                      Checked="OnLinkDeviceCheckedChanged" Unchecked="OnLinkDeviceCheckedChanged" />
        </StackPanel>

        <StackPanel Grid.Row="10" x:Name="LinkDevicePanel" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="Dispositivo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="DeviceComboBox" Padding="4" DisplayMemberPath="Name" Margin="0,0,0,8" />
            <TextBlock Text="PIN en el dispositivo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="DevicePinTextBox" MaxLength="50" Padding="4" />
        </StackPanel>

        <TextBlock Grid.Row="11" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,10,0,10" VerticalAlignment="Top" />

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
