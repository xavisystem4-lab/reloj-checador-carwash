<Window x:Class="RelojChecador.WPF.Views.EditEmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar empleado" Height="700" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Número y fecha de alta NO son editables aquí a propósito: Number es la clave de
             negocio (índice único, no tiene setter en el dominio tras Employee.Create) y
             HireDate tampoco expone un método de actualización — ver Employee.cs. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Número de empleado" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock x:Name="NumberTextBlock" Padding="4" Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Nombre completo *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBox x:Name="FullNameTextBox" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Sucursal *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="BranchComboBox" Padding="4" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Estatus *" FontWeight="SemiBold" Margin="0,0,0,2" />
            <ComboBox x:Name="StatusComboBox" Padding="4" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Departamento" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="DepartmentTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Puesto" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="PositionTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="PhoneTextBox" Padding="4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Correo" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox x:Name="EmailTextBox" Padding="4" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="7" x:Name="ErrorTextBlock" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Guardar" Width="90" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
