<Window x:Class="RelojChecador.WPF.Views.SendEmployeesProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviando empleados al reloj" Height="420" Width="460"
        MinHeight="360" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enviando empleados al reloj" FontSize="16" FontWeight="Bold" Margin="0,0,0,2" />
        <TextBlock Grid.Row="1" x:Name="DeviceTextBlock" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14" />

        <ProgressBar Grid.Row="2" x:Name="ProgressBarControl" Height="18" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"
                   Text="Preparando envío..." />
        <TextBlock Grid.Row="4" x:Name="CurrentEmployeeTextBlock" Foreground="{DynamicResource BrushTextSecondary}"
                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" Visibility="Collapsed" />

        <UniformGrid Grid.Row="5" Columns="3" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="SentCountTextBlock" Text="0" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center" />
                <TextBlock Text="Exitosos" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="FailedCountTextBlock" Text="0" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource BrushDanger}" HorizontalAlignment="Center" />
                <TextBlock Text="Fallidos" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="SkippedCountTextBlock" Text="0" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource BrushWarning}" HorizontalAlignment="Center" />
                <TextBlock Text="Omitidos" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </UniformGrid>

        <StackPanel Grid.Row="6" x:Name="FailuresPanel" Visibility="Collapsed" Margin="0,0,0,6">
            <TextBlock Text="Detalle de fallas" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
        </StackPanel>
        <ListBox Grid.Row="7" x:Name="FailuresListBox" Visibility="Collapsed" Margin="0,0,0,10"
                  FontSize="11.5" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" Width="110" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
