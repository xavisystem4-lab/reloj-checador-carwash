<Window x:Class="RelojChecador.WPF.Views.DuplicateEmployeesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar repetidos" Height="660" Width="900"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔍 Empleados repetidos" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10">
            Registros con el mismo nombre (sin contar mayúsculas ni acentos) o donde uno es la versión corta
            del otro ("Adrian Uribe" = "Adrian Uribe Garcia"). En cada grupo, "Se queda" es el registro que se
            conserva: recibe las marcaciones, el PIN y los datos que le falten de los demás. Los marcados en
            "Eliminar" se borran. Los grupos "⚠ Revisar" tienen nombres que podrían ser personas distintas y
            no se marcan solos.
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="UseFullestNameCheckBox" Content="Dejarle el nombre más completo del grupo a quien se queda"
                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="SummaryTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="RowsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Grupo" Binding="{Binding GroupLabel}" Width="80" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Se queda" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="{Binding RadioGroup}" HorizontalAlignment="Center"
                                         IsChecked="{Binding IsKeeper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Eliminar" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" IsEnabled="{Binding CanDelete}"
                                      IsChecked="{Binding ToDelete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding FullName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Estatus" Binding="{Binding StatusText}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Marcaciones" Binding="{Binding PunchCount}" Width="95" IsReadOnly="True" />
                <DataGridTextColumn Header="PIN" Binding="{Binding PinText}" Width="50" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cerrar" Width="100" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button x:Name="DeleteButton" Content="🧹 Eliminar repetidos" MinWidth="240" Padding="12,6"
                    Foreground="{DynamicResource BrushDanger}" FontWeight="Bold" Click="OnDeleteClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
