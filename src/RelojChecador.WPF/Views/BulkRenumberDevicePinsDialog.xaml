<Window x:Class="RelojChecador.WPF.Views.BulkRenumberDevicePinsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renumerar PINs del reloj" Height="640" Width="900"
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔢 Renumerar PINs del reloj" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BrushDanger}" Margin="0,0,0,10">
            Mueve la huella YA enrolada de cada persona al PIN igual a su Número de empleado — pedido explícito.
            Esta operación NUNCA se había probado contra este reloj real; hazla con calma, no cierres la app ni
            desconectes el dispositivo mientras corre (puede tardar varios minutos con muchas personas). Si algo
            falla a medias en una persona, esa persona en particular queda exactamente como estaba — nunca se
            borra nada hasta confirmar que la copia llegó completa al PIN nuevo. Si varios PIN destino forman
            una cadena cerrada entre sí (el PIN que necesita uno lo tiene otro de la lista, y así en círculo),
            a esa persona se le mueve dos veces: primero a un PIN temporal para desatorar al resto, y al final
            a su PIN definitivo — verás "⏳ Aparcado..." mientras tanto, es normal.
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="SelectAllCheckBox" Content="Seleccionar todo lo movible" VerticalAlignment="Center"
                      Margin="0,0,16,0" Checked="OnSelectAllChanged" Unchecked="OnSelectAllChanged" />
            <TextBlock x:Name="SelectedCountTextBlock" Text="0 seleccionado(s) de 0" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="RowsGrid" ItemsSource="{Binding}" AutoGenerateColumns="False"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding HasValidTarget}"
                                      HorizontalAlignment="Center" Click="OnRowCheckedChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PIN actual" Binding="{Binding Row.DeviceUserPin}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Nombre (reloj)" Binding="{Binding Row.Name}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="Vinculado a" Binding="{Binding Row.LinkedEmployeeDisplay}" Width="180" IsReadOnly="True" />
                <!-- Editable — pedido explícito del usuario: poder ajustar el PIN destino a
                     mano en vez de depender solo del Número sugerido. -->
                <DataGridTextColumn Header="PIN destino" Binding="{Binding TargetPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" IsReadOnly="False" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cerrar" Width="100" Margin="0,0,8,0" Click="OnCloseClick" IsCancel="True" />
            <Button x:Name="ApplyButton" Content="Renumerar seleccionados" Width="220"
                    Foreground="{DynamicResource BrushDanger}" FontWeight="Bold"
                    Click="OnApplyClick" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
