<UserControl x:Class="RelojChecador.WPF.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RelojChecador.WPF.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <UserControl.Resources>
        <converters:AttendanceColorToBrushConverter x:Key="AttendanceColorToBrushConverter" />

        <!-- La tabla es ancha (16 columnas): el tema global (RowHeight fijo de 36 px y relleno de
             12 px a cada lado en celdas y encabezados) cortaba encabezados ("Horas norn"), textos
             y la segunda línea de las insignias de días. Aquí: relleno chico, encabezados que se
             acomodan en dos líneas y texto centrado verticalmente. -->
        <Style x:Key="PayrollHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PayrollCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PayrollCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PayrollCellTextTrimmed" TargetType="TextBlock" BasedOn="{StaticResource PayrollCellText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
        <Style x:Key="PayrollCellTextWrapped" TargetType="TextBlock" BasedOn="{StaticResource PayrollCellText}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reportes" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Horas trabajadas e insumo de nómina por semana. El primer día sin checada de la semana se toma como descanso; cualquier otro día sin checada se marca como falta — el sueldo semanal sale completo de cualquier forma, es el administrador quien ajusta a mano horas extra, faltas o cualquier otro cambio (botón &quot;Deducciones&quot;)."
                   FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <!-- Semana lunes a domingo (ver WeekBoundary) — navegación en vez de un rango de
             fechas libre, porque la nómina es inherentemente semanal. -->
        <!-- WrapPanel, no StackPanel — pedido explícito del usuario: "revisa también en la
             app de escritorio" (que se adapte al redimensionar la ventana), mismo criterio
             que EmployeesView/BranchesView. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="‹ Semana anterior" Command="{Binding PreviousWeekCommand}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding WeekRangeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="180" />
            <Button Content="Semana siguiente ›" Command="{Binding NextWeekCommand}" Margin="0,0,16,0" />
            <Button Content="Actualizar" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <Button Content="⬇ Exportar CSV" Click="OnExportCsvClick" Margin="0,0,8,0" />
            <!-- Pedido explícito del usuario: previsualización tamaño Carta con el
                 logotipo del negocio, con Imprimir/Exportar Excel/Exportar PDF — mismo
                 diseño que ya quedó en el Dashboard web (ver PayrollReportPreviewDialog). -->
            <Button Content="📊 Vista previa e imprimir" Click="OnPreviewReportClick" />
        </WrapPanel>

        <!-- Filtros — mismo criterio que Empleados: en memoria sobre lo ya calculado para
             la semana actual, sin volver a recalcular la nómina por escribir en el
             buscador o cambiar la sucursal (ver PayrollViewModel.ApplyFilter). -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Width="220" VerticalContentAlignment="Center" Margin="0,0,16,0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Sucursal:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox Width="200"
                      ItemsSource="{Binding BranchFilterOptions}"
                      SelectedItem="{Binding SelectedBranchFilter, Mode=TwoWay}" />
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="5" ItemsSource="{Binding PayrollRows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowHeight="NaN" MinRowHeight="38"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  ColumnHeaderStyle="{StaticResource PayrollHeaderStyle}" CellStyle="{StaticResource PayrollCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeName}" Width="*" MinWidth="150"
                                    ElementStyle="{StaticResource PayrollCellTextTrimmed}" />
                <!-- Sucursal y, debajo, el departamento (conserva la ubicación original de alguien
                     fusionado a otra sucursal — ver EmployeesViewModel.ApplyCatalogReplaceAsync;
                     pedido explícito del usuario: "que en los reportes se acomoden por sucursal").
                     Una sola columna de dos líneas en vez de dos columnas: la tabla tiene que
                     caber completa en la ventana. -->
                <DataGridTemplateColumn Header="Sucursal / Depto." Width="120" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding BranchName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding BranchName}" />
                                <TextBlock Text="{Binding Department}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BrushTextSecondary}" ToolTip="{Binding Department}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Descanso = primer día sin marcación de la semana (lun→dom); Falta =
                     cualquier día sin marcación posterior a ese — ver comentario de clase
                     de WorkedHoursCalculator. Solo informativo: el sueldo de la derecha ya
                     sale completo, el administrador ajusta a mano lo que corresponda.
                     Verde=puntual, amarillo=retardo (tolerancia 10 min), rojo=falta — ver
                     PunctualityClassifier; gris=sin juicio (descanso/pendiente/horario
                     especial). Los 7 días van SIEMPRE en una sola fila (StackPanel, no
                     WrapPanel): con fila de altura fija la segunda línea quedaba cortada. -->
                <DataGridTemplateColumn Header="Checadas de la semana" Width="398" MinWidth="398">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding DailyBadges}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Color, Converter={StaticResource AttendanceColorToBrushConverter}, ConverterParameter=Surface}"
                                                BorderBrush="{Binding Color, Converter={StaticResource AttendanceColorToBrushConverter}}"
                                                BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="1">
                                            <TextBlock FontSize="10.5"
                                                       Foreground="{Binding Color, Converter={StaticResource AttendanceColorToBrushConverter}}">
                                                <Run Text="{Binding DayLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Faltas" Binding="{Binding AbsenceCount}" Width="56" MinWidth="56"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <DataGridTextColumn Header="Horas normales" Binding="{Binding RegularTimeText}" Width="80" MinWidth="80"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <DataGridTextColumn Header="Horas extra" Binding="{Binding OvertimeTimeText}" Width="66" MinWidth="66"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <DataGridTextColumn Header="Sueldo semanal" Binding="{Binding WeeklySalaryText}" Width="90" MinWidth="90"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <DataGridTextColumn Header="Pago horas extra" Binding="{Binding Summary.OvertimePay, StringFormat='{}{0:C}'}" Width="80" MinWidth="80"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <DataGridTextColumn Header="Total a pagar" Binding="{Binding Summary.TotalPay, StringFormat='{}{0:C}'}" Width="90" MinWidth="90"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <!-- ISR + IMSS + Otro en UNA columna: se capturan a mano (ver "Deducciones"), nunca
                     los calcula el sistema — ver comentario de clase de PayrollDeduction. El
                     desglose sigue en el diálogo y en el CSV. -->
                <DataGridTextColumn Header="Deducciones" Binding="{Binding DeductionsTotal, StringFormat='{}{0:C}'}" Width="106" MinWidth="106"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <DataGridTextColumn Header="Neto a pagar" Binding="{Binding NetPay, StringFormat='{}{0:C}'}" Width="90" MinWidth="90"
                                    ElementStyle="{StaticResource PayrollCellText}" />
                <!-- Advertencias: máximo 2 líneas con "…"; el detalle completo (una advertencia por línea)
                     sale al pasar el ratón. Antes envolvía TODO el texto y una fila con varias
                     advertencias (dobles checadas, turnos sin cerrar) medía cientos de píxeles. -->
                <DataGridTemplateColumn Header="Advertencias" Width="2*" MinWidth="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding WarningsText}" FontSize="11" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="30" VerticalAlignment="Center"
                                       ToolTip="{Binding WarningsTooltip}" ToolTipService.ShowDuration="60000" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="98" MinWidth="98">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- DataContext heredado = el PayrollRow de la fila (igual
                                 patrón que EmployeesView) — el handler lo lee directo sin Tag. -->
                            <Button Content="Deducciones" ToolTip="Editar deducciones (ISR, IMSS, otro)" Padding="8,4" FontSize="12"
                                    VerticalAlignment="Center" Click="OnEditDeductionsClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
