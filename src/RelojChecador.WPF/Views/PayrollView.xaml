<UserControl x:Class="RelojChecador.WPF.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1050">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reportes" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Horas trabajadas e insumo de nómina por semana. ISR/IMSS/otro se capturan manualmente por empleado (botón &quot;Editar deducciones&quot;) — el sistema nunca los calcula."
                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <!-- Semana lunes a domingo (ver WeekBoundary) — navegación en vez de un rango de
             fechas libre, porque la nómina es inherentemente semanal. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="‹ Semana anterior" Command="{Binding PreviousWeekCommand}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding WeekRangeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="180" />
            <Button Content="Semana siguiente ›" Command="{Binding NextWeekCommand}" Margin="0,0,16,0" />
            <Button Content="Actualizar" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <Button Content="⬇ Exportar CSV" Click="OnExportCsvClick" Margin="0,0,8,0" />
            <!-- Pedido explícito del usuario: previsualización tamaño Carta con el
                 logotipo del negocio, con Imprimir/Exportar Excel/Exportar PDF — mismo
                 diseño que ya quedó en el Dashboard web (ver PayrollReportPreviewDialog). -->
            <Button Content="📊 Vista previa e imprimir" Click="OnPreviewReportClick" />
        </StackPanel>

        <!-- Filtros — mismo criterio que Empleados: en memoria sobre lo ya calculado para
             la semana actual, sin volver a recalcular la nómina por escribir en el
             buscador o cambiar la sucursal (ver PayrollViewModel.ApplyFilter). -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Width="220" VerticalContentAlignment="Center" Margin="0,0,16,0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Sucursal:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox Width="200"
                      ItemsSource="{Binding BranchFilterOptions}"
                      SelectedItem="{Binding SelectedBranchFilter, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="5" ItemsSource="{Binding PayrollRows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeName}" Width="*" />
                <DataGridTextColumn Header="Sucursal" Binding="{Binding BranchName}" Width="120" />
                <!-- Conserva la ubicación original de alguien fusionado a otra sucursal
                     (ver EmployeesViewModel.ApplyCatalogReplaceAsync) — pedido explícito del
                     usuario: "que en los reportes se acomoden por sucursal". -->
                <DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="110" />
                <DataGridTextColumn Header="Horas normales" Binding="{Binding RegularTimeText}" Width="100" />
                <DataGridTextColumn Header="Horas extra" Binding="{Binding OvertimeTimeText}" Width="90" />
                <DataGridTextColumn Header="Sueldo semanal" Binding="{Binding WeeklySalaryText}" Width="110" />
                <DataGridTextColumn Header="Pago horas extra" Binding="{Binding Summary.OvertimePay, StringFormat='{}{0:C}'}" Width="120" />
                <DataGridTextColumn Header="Total a pagar" Binding="{Binding Summary.TotalPay, StringFormat='{}{0:C}'}" Width="110" />
                <!-- ISR/IMSS/Otro: capturados a mano (ver "Editar deducciones" más abajo),
                     nunca calculados por el sistema — ver comentario de clase de
                     PayrollDeduction. -->
                <DataGridTextColumn Header="ISR" Binding="{Binding Deductions.IsrAmount, StringFormat='{}{0:C}'}" Width="90" />
                <DataGridTextColumn Header="IMSS" Binding="{Binding Deductions.ImssAmount, StringFormat='{}{0:C}'}" Width="90" />
                <DataGridTextColumn Header="Otro" Binding="{Binding Deductions.OtherAmount, StringFormat='{}{0:C}'}" Width="90" />
                <DataGridTextColumn Header="Neto a pagar" Binding="{Binding NetPay, StringFormat='{}{0:C}'}" Width="110" />
                <DataGridTextColumn Header="Advertencias" Binding="{Binding WarningsText}" Width="200" />
                <DataGridTemplateColumn Header="" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- DataContext heredado = el PayrollRow de la fila (igual
                                 patrón que EmployeesView) — el handler lo lee directo sin Tag. -->
                            <Button Content="Editar deducciones" Padding="8,4" FontSize="12" Click="OnEditDeductionsClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
