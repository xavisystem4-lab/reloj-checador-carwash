<Window x:Class="RelojChecador.WPF.Views.DeviceUsersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuarios del reloj" Height="560" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Usuarios del reloj" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="StatusTextBlock" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Actualizar" Click="OnRefreshClick" Margin="0,0,8,0" />
            <CheckBox x:Name="SelectAllCheckBox" Content="Seleccionar todos" VerticalAlignment="Center" Margin="0,0,16,0"
                      Click="OnSelectAllClick" />
            <Button Content="🗑 Eliminar seleccionados" Click="OnDeleteSelectedClick" Margin="0,0,8,0" />
            <!-- Pedido explícito del usuario: que el PIN real de cada quien en el reloj sea
                 igual a su Número de empleado, no solo el folio del software (ver
                 BulkRenumberDevicePinsDialog). -->
            <Button Content="🔢 Renumerar PINs" Foreground="{DynamicResource BrushDanger}" Click="OnBulkRenumberClick" />
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="UsersDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PIN" Binding="{Binding DeviceUserPin}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Nombre (en el reloj)" Binding="{Binding Name}" Width="150" IsReadOnly="True" />
                <!-- A quién dice el SOFTWARE que le pertenece este PIN — pedido explícito
                     del usuario, para comparar de un vistazo el PIN real del reloj contra el
                     empleado vinculado, sin cruzarlo a mano con Empleados (ver
                     DevicesViewModel.LoadDeviceUsersAsync). -->
                <DataGridTextColumn Header="Vinculado a (software)" Binding="{Binding LinkedEmployeeDisplay}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="Privilegio" Binding="{Binding PrivilegeLabel}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Habilitado" Binding="{Binding EnabledLabel}" Width="90" IsReadOnly="True" />
                <DataGridTemplateColumn Header="" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- DataContext heredado = el DeviceUserRow de la fila (mismo
                                 patrón que EmployeesView/BranchesView) — los handlers lo
                                 leen directo sin Tag. -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Padding="8,3" FontSize="12" Margin="0,0,6,0" Click="OnEditUserClick" />
                                <!-- Distinto de "Editar" a propósito: cambiar el PIN mueve la
                                     huella ya enrolada (ver DevicesViewModel.
                                     ChangeDeviceUserPinAsync) — es una operación bastante más
                                     delicada que corregir nombre/habilitado, se le da su
                                     propio botón e ícono para que no se confundan. -->
                                <Button Content="🔁 Cambiar PIN" Padding="8,3" FontSize="12" Margin="0,0,6,0" Click="OnChangePinClick" />
                                <Button Content="Eliminar" Padding="8,3" FontSize="12" Click="OnDeleteUserClick" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cerrar" Width="90" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
