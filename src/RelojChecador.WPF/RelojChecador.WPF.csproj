<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RelojChecador.Domain\RelojChecador.Domain.csproj" />
    <ProjectReference Include="..\RelojChecador.Application\RelojChecador.Application.csproj" />
    <ProjectReference Include="..\RelojChecador.Infrastructure.Data\RelojChecador.Infrastructure.Data.csproj" />
    <ProjectReference Include="..\RelojChecador.Infrastructure.Devices\RelojChecador.Infrastructure.Devices.csproj" />
    <ProjectReference Include="..\RelojChecador.Infrastructure.Cloud\RelojChecador.Infrastructure.Cloud.csproj" />
    <ProjectReference Include="..\RelojChecador.Infrastructure.Updates\RelojChecador.Infrastructure.Updates.csproj" />
    <ProjectReference Include="..\RelojChecador.Infrastructure.Security\RelojChecador.Infrastructure.Security.csproj" />
    <ProjectReference Include="..\RelojChecador.Infrastructure.Logging\RelojChecador.Infrastructure.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <!-- appsettings.json: solo Url + AnonKey de Supabase (seguros de commitear — están
       pensados para ser públicos, protegidos por RLS). La clave de escritura real
       (ServiceRoleKey) NUNCA vive aquí — ver App.xaml.cs, se lee de
       %LocalAppData%\RelojChecador\appsettings.Local.json, fuera del repo y de la carpeta
       de instalación.

       ExcludeFromSingleFile=true por la misma razón que zkemkeeper.dll (ver
       RelojChecador.Infrastructure.Devices.csproj): PublishSingleFile empaqueta por
       defecto los archivos de contenido DENTRO del único .exe, pero un archivo pensado
       para poder editarse/reemplazarse sin recompilar necesita existir como archivo
       físico real junto al .exe. -->
  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- Logotipo del negocio ("Drive In Car Wash") mostrado en la barra superior de
       MainWindow — Build Action "Resource" (no "None"/"Content") para poder referenciarlo
       desde XAML con un pack URI relativo ("Assets/DriveInLogo.png"), igual que cualquier
       imagen embebida de WPF. -->
  <ItemGroup>
    <Resource Include="Assets\DriveInLogo.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Permite restaurar/compilar contra las reference assemblies de Windows Desktop desde macOS/Linux.
         La compilación (dotnet build) puede funcionar aquí, pero SOLO se puede EJECUTAR y probar
         visualmente en Windows real. No asumir que "compila" significa "funciona en Windows". -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Ícono real de la app (marca GalaCheck, pedido explícito del usuario) — queda
         embebido en el .exe compilado, así que se ve solo con esto en el ícono de la
         barra de tareas, en el Explorador de Windows y en CUALQUIER acceso directo que
         apunte al .exe (incluido el que crea el instalador), sin depender de que Inno
         Setup especifique un ícono aparte. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
