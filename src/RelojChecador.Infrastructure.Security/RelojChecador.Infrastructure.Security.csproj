<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RelojChecador.Application\RelojChecador.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Usa Windows Credential Manager (DPAPI); solo tiene sentido en Windows.
         EnableWindowsTargeting permite compilar desde macOS/Linux para detectar errores temprano,
         pero la ejecución real solo se puede validar en Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
